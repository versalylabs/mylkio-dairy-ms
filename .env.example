# Neon (Postgres + Auth). Set these in Vercel for Preview and Production, never in git.
# Use a separate Neon branch (or project) for Preview so preview data never touches production.

# Pooled connection string from the Neon console (host contains "-pooler"). Used by the app.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct (non-pooled) connection string. Used only by `npm run db:migrate` on your own machine.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth: the branch's Auth URL from the Neon console (Auth tab).
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth

# Secret used to sign the session cookie. At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-secret-of-32-or-more-characters
